# ---- Database ----
# MVP: local SQLite. Migrate to MySQL by changing only this line:
#   DATABASE_URL=mysql+pymysql://user:pass@host:3306/kairos?charset=utf8mb4
DATABASE_URL=sqlite:///./data/kairos.db

# ---- Auth ----
# 留空则首次启动随机生成并保存到 data/jwt_secret（多实例部署时请显式设置同一个值）
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# ---- Data provider: auto | seed | akshare | tencent ----
# auto: try live AkShare (EastMoney), then Tencent/Sina, fall back to built-in
# seed data if neither is reachable.
PROVIDER=auto

# ---- AI provider: auto | rule | deepseek | openai | anthropic ----
# 不配任何 key 也能用：策略生成回落到内置规则解析器，研报 / 叙事 / 公告摘要的 AI 部分跳过。
#   auto      = deepseek（兼容旧配置；没有 key 时等同 rule）
#   rule      = 不调用任何 LLM
#   deepseek  = DeepSeek，默认 deepseek-flash 并关闭思考（国内直连）
#   openai    = 任意 OpenAI 兼容接口，需填 LLM_MODEL，LLM_BASE_URL 留空为 OpenAI 官方
#   anthropic = Claude 原生 Messages API，默认 claude-opus-5-5（大陆服务器无法直连）
AI_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# JSON，浅合并进请求体；值为 null 表示删除该字段（如推理模型不接受 temperature）
LLM_EXTRA_BODY=
#
# 示例 —— 通义千问：
#   AI_PROVIDER=openai
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# 示例 —— 本地 Ollama（无需 key）：
#   AI_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3
# 示例 —— Claude：
#   AI_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#
# 旧配置仍然有效（LLM_* 留空时 deepseek / auto 读取这里）：
DEEPSEEK_API_KEY=

# ---- AI 操盘手 ----
# 管理员在「AI 操盘」页建账户后，交易日 08:50 盘前分析、15:45 盘后结算复盘、周六周度反思。
# 需要上面的 LLM 已配置（模型须支持工具调用）。
ENABLE_AGENT=true
# Tavily 联网搜索 key（https://tavily.com）。留空时 agent 只能查站内数据和东财快讯
TAVILY_API_KEY=

# ---- Collector ----
ENABLE_COLLECTOR=true
COLLECT_INTERVAL_SECONDS=60

# ---- CORS (comma-separated origins, or *) ----
CORS_ORIGINS=*

REPORTS_DIR=./data/reports
