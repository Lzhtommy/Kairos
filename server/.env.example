# ---- Database ----
# MVP: local SQLite. Migrate to MySQL by changing only this line:
#   DATABASE_URL=mysql+pymysql://user:pass@host:3306/kairos?charset=utf8mb4
DATABASE_URL=sqlite:///./data/kairos.db

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# ---- Data provider: auto | seed | akshare | tencent ----
# auto: try live AkShare (EastMoney), then Tencent/Sina, fall back to built-in
# seed data if neither is reachable.
PROVIDER=auto

# ---- AI provider: auto | rule | deepseek ----
# auto: use DeepSeek if DEEPSEEK_API_KEY set, else deterministic rule-based parser.
# (DeepSeek chosen because the Anthropic API is geo-blocked from mainland servers.)
AI_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Collector ----
ENABLE_COLLECTOR=true
COLLECT_INTERVAL_SECONDS=60

# ---- CORS (comma-separated origins, or *) ----
CORS_ORIGINS=*

REPORTS_DIR=./data/reports
